{
  "name": "embedded-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "시각화로 배우는 전기전자와 임베디드 기초",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "graph": "node scripts/build-graph.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "sources:sync": "node scripts/sync-sources.mjs",
    "check": "npm run graph && npm run validate:content && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests package.json vite.config.js playwright.config.js index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
